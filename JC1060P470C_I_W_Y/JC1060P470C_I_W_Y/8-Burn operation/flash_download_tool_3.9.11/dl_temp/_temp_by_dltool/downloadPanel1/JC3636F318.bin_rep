␀␀/configwifi␀/wifilist␀␀␀<!DOCTYPE html><html lang='en'><head><meta charset='UTF-8'><meta name='viewport'content='width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no'><title>WiFi Config</title><style>*{box-sizing:border-box;margin:0;padding:0;font-family:sans-serif}body{padding:20px;background:#f4f7f9;color:#333}.title{font-size:28px;font-weight:bold;color:#006898;text-align:center;margin-bottom:20px}.input-group{margin-bottom:15px}.input-group label{display:block;font-size:16px;margin-bottom:5px}.input{width:100%;padding:10px;font-size:18px;border:1px solid#ccc;border-radius:8px}.button-row{display:flex;justify-content:space-between;margin-top:20px}.button{flex:1;margin:0 5px;padding:12px 0;background-color:#33cbcc;color:#fff;font-size:18px;border:none;border-radius:8px;cursor:pointer;transition:background 0.3s}.button:active{background-color:#28a7a8}.wifititle{margin-top:30px;font-size:20px;display:flex;justify-content:space-between;align-items:center}.wifititle span:last-child{color:#006898;cursor:pointer;font-size:16px}.wifilist{margin-top:10px}.wifi-item{display:flex;justify-content:space-between;align-items:center;padding:12px;border:1px solid#ccc;border-radius:8px;margin-bottom:10px;background:#fff;cursor:pointer;transition:background 0.2s}.wifi-item:active{background:#e0f7ff}.wifi-info{display:flex;flex-direction:column}.wifi-ssid{font-size:18px;font-weight:bold}.wifi-security{font-size:14px;color:#777}.wifi-signal{font-size:20px;color:#33cbcc;font-family:monospace}.loading,.box{display:none}.box{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);z-index:998}.loading{position:fixed;top:40%;left:50%;transform:translate(-50%,-50%);background:#fff;padding:30px;border-radius:15px;display:flex;flex-direction:column;align-items:center;z-index:999;font-size:16px;color:#006898}.loading svg{margin-bottom:10px}.path{stroke:#33cbcc;stroke-width:2;stroke-dasharray:95,126;stroke-dashoffset:0;animation:loading-dash 1.5s ease-in-out infinite;fill:none}@keyframes loading-dash{0%{stroke-dasharray:1,126;stroke-dashoffset:0}50%{stroke-dasharray:95,126;stroke-dashoffset:-31px}100%{stroke-dasharray:6,120;stroke-dashoffset:-120px}}</style></head><body onload='initData()'><div class='box'><div class='loading'><svg viewBox='0 0 50 50'width='40'height='40'><circle cx='25'cy='25'r='20'class='path'></circle></svg><span id='tip'></span></div></div><div class='title'>Configure WiFi</div><div class='input-group'><label for='ssid'>SSID</label><input class='input'id='ssid'type='text'/></div><div class='input-group'><label for='pwd'>Password</label><input class='input'id='pwd'type='password'/></div><div class='button-row'><button class='button'onclick='connwifi()'>Submit</button><button class='button'onclick='reset()'>Reset</button></div><div class='wifititle'><span>Available WiFi</span><span onclick='getWifiList()'>Refresh</span></div><div class='wifilist'id='wifilist'></div><script>function initData(){setTimeout(function(){getWifiList()},1000)}function showloading(msg){document.getElementsByClassName('box')[0].style.display='block';document.getElementsByClassName('loading')[0].style.display='flex';document.getElementById('tip').innerText=msg}function hideloading(){document.getElementsByClassName('box')[0].style.display='none';document.getElementsByClassName('loading')[0].style.display='none'}function getSignalBars(level){var bars=['','â–‚','â–‚â–„','â–‚â–„â–†','â–‚â–„â–†â–ˆ','â–‚â–„â–†â–ˆâ–ˆ'];return bars[parseInt(level)||0]}function getWifiList(){document.getElementById('tip').innerText='';showloading('Scanning wifi...');doget('/wifilist',function(result){var code=2;var res_txt='';var codeIndex=result.indexOf('code:');var commaIndex=result.indexOf(',',codeIndex);if(codeIndex!==-1){code=parseInt(result.substring(codeIndex+5,commaIndex),10)}var resultIndex=result.indexOf('result:');if(resultIndex!==-1){res_txt=result.substring(resultIndex+7)}var arr=res_txt.split(',');if(code==0){hideloading();var html='';for(item of arr){if(item==='')continue;var parts=item.split('|');var ssid=parts[0]||'';var signal=parts[1]||'0';var security=parts[2]||'OPEN';html+='<div class="wifi-item" onclick="setSsid(event)">';html+='<div class="wifi-info">';html+='<div class="wifi-ssid">'+ssid+'</div>';html+='<div class="wifi-security">'+security+'</div>';html+='</div>';html+='<div class="wifi-signal">'+getSignalBars(signal)+'</div>';html+='</div>'}document.getElementById('wifilist').innerHTML=html}else{showloading(res_txt);setTimeout(hideloading,4000)}})}function setSsid(event){var ssid=event.currentTarget.querySelector('.wifi-ssid').innerText;document.getElementById('ssid').value=ssid}function reset(){document.getElementById('ssid').value='';document.getElementById('pwd').value=''}function connwifi(){var ssid=document.getElementById('ssid').value;if(!ssid){showloading('SSID is required');setTimeout(hideloading,1500);return}var pwd=document.getElementById('pwd').value;var url='/configwifi?ssid='+encodeURIComponent(ssid)+'&pwd='+encodeURIComponent(pwd);showloading('Connecting...');doget(url,function(result){var code=2;var res_txt='';var codeIndex=result.indexOf('code:');var commaIndex=result.indexOf(',',codeIndex);var resultIndex=result.indexOf('result:');if(resultIndex!==-1){res_txt=result.substring(resultIndex+7)}showloading(res_txt);setTimeout(hideloading,4000)})}function doget(url,callback){var ajax=new XMLHttpRequest();ajax.open('get',url);ajax.send();ajax.onreadystatechange=function(){if(ajax.readyState===4&&ajax.status===200){callback(ajax.responseText)}}}</script></body></html>␀␀␀␀E (%lu) %s: Error opening WIFI NVS handle!
